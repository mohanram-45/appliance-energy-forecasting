# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
.ipynb_checkpoints/
.pytest_cache/

# Data (regenerated by the pipeline)
data/raw/*.csv
data/raw/*.zip

# Model / OS junk
*.ckpt
.DS_Store
Thumbs.db

